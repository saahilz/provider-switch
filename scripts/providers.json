      "capabilities": { "modelDiscovery": false, "testConnection": true }
    },
    {
      "id": "anthropic-compatible",
      "label": "Anthropic-compatible gateway",
      "auth": "bearer_token",
      "defaultBaseUrl": null,
      "requiresBaseUrl": true,
      "knownHosts": [],
      "models": [],
      "capabilities": { "modelDiscovery": false, "testConnection": true }
    },
    {
      "id": "bedrock",
      "label": "Amazon Bedrock",
      "auth": "none",
      "defaultBaseUrl": null,
      "requiresBaseUrl": false,
      "knownHosts": [],
      "models": [],
      "env": { "CLAUDE_CODE_USE_BEDROCK": "1" },
      "capabilities": { "modelDiscovery": false, "testConnection": false }
    },
    {
      "id": "vertex",
      "label": "Google Vertex AI",
      "auth": "none",
      "defaultBaseUrl": null,
      "requiresBaseUrl": false,
      "knownHosts": [],
      "models": [],
      "env": { "CLAUDE_CODE_USE_VERTEX": "1" },
      "capabilities": { "modelDiscovery": false, "testConnection": false }
    }
  ]
}
